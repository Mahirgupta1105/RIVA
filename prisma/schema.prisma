generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          UserRole @default(VIEWER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum LtvTier {
  STARTER
  PRO
  ENTERPRISE
}

enum IncidentStatus {
  DETECTED
  CLASSIFIED
  RECOVERY_IN_PROGRESS
  RECOVERED
  ESCALATED
  CLOSED
}

enum RecoveryRail {
  SAME_RAIL
  UPI_INTENT
  WHATSAPP_LINK
  ALTERNATE_RAIL
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
}

enum RecoveryActionResult {
  SUCCESS
  FAILED
  PENDING
  SKIPPED
  PENDING_REVIEW
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
  RECOVERED
}

model Customer {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  ltvTier       LtvTier   @default(STARTER)
  lifetimeValue Float      @default(0.0)
  incidents     Incident[]
  transactions  Transaction[]
}

model Incident {
  id                   String           @id @default(uuid())
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  status               IncidentStatus   @default(DETECTED)
  cause                String?          // Failure category
  bank                 String?          // Bank identifier (e.g. "HDFC")
  originalMethod       PaymentMethod?   // The original payment method that failed
  classificationSource String?          // "AI" or "HEURISTIC"
  amount               Float            @default(0.0)
  orderId              String?
  transactionId        String?
  gateway              String?
  errorCode            String?
  errorMessage         String?
  severity             Severity         @default(MEDIUM)
  recoverability       Float            @default(0.0) // 0.0 to 1.0
  retryCount           Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  actions              RecoveryAction[]
}

model RecoveryAction {
  id             String               @id @default(uuid())
  incidentId     String
  incident       Incident             @relation(fields: [incidentId], references: [id])
  rail           RecoveryRail
  result         RecoveryActionResult
  details        String?              // Captures raw gateway errors or success messages
  attemptNumber  Int
  duration       Int?                  // Execution time in ms
  timestamp      DateTime             @default(now())

  @@unique([incidentId, attemptNumber])
}

model Transaction {
  id            String            @id @default(uuid())
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  amount        Float
  method        PaymentMethod
  bank          String?
  gateway       String?
  status        TransactionStatus
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  previousHash String?
  hash         String   @unique
  action       String
  actor        String   @default("SYSTEM") // "AI" or "HUMAN_OPERATOR"
  payload      Json
  timestamp    DateTime @default(now())

  @@index([previousHash])
}
